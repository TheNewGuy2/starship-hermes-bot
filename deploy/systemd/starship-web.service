[Unit]
Description=Starship Web (FastAPI)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/starship-data

[Service]
Type=simple
User=starship
Group=starship
WorkingDirectory=/opt/starship-alpha/app
EnvironmentFile=/opt/starship-alpha/.env

ExecStart=/opt/starship-alpha/app/.venv/bin/python -m uvicorn starship_web.app:app --host 127.0.0.1 --port 8000

Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
