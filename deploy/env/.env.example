# --- Secrets / credentials only ---

# Private ops page
STARSHIP_ADMIN_USER=
STARSHIP_ADMIN_PASSWORD=

# Future live-execute guardrails
STARSHIP_MAX_SIGNAL_AGE_MINUTES=60
STARSHIP_MAX_PREVIEW_AGE_MINUTES=15
STARSHIP_MAX_SNAPSHOT_AGE_MINUTES=15
STARSHIP_EXECUTION_MODE=dry_run
STARSHIP_ALLOW_LIVE_EXECUTION=false

# Tastytrade auth
TT_CLIENT_ID=
TT_CLIENT_SECRET=
TT_REFRESH_TOKEN=

# Engine ingest signing (engine -> web)
ENGINE_INGEST_SECRET=

# Slack webhook (web -> Slack)
SLACK_WEBHOOK_URL=

# Optional E*TRADE auth / execution
BROKER_PROVIDER=etrade
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=
ETRADE_ENV=sandbox
ETRADE_CALLBACK_URL=oob
ETRADE_DEFAULT_ACCOUNT_ID_KEY=
ETRADE_OAUTH_TOKEN=
ETRADE_OAUTH_TOKEN_SECRET=
