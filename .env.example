BROKER_PROVIDER=tastytrade
TT_CLIENT_ID=your-client-id
TT_CLIENT_SECRET=your-client-secret
TT_REFRESH_TOKEN=your-refresh-token
TT_IS_TEST=false

# Private ops page
STARSHIP_ADMIN_USER=
STARSHIP_ADMIN_PASSWORD=

# Optional server-side runtime loading
STARSHIP_ENV_FILE=
STARSHIP_SECRETS_DIR=

# Future live-execute guardrails
STARSHIP_MAX_SIGNAL_AGE_MINUTES=60
STARSHIP_MAX_PREVIEW_AGE_MINUTES=15
STARSHIP_MAX_SNAPSHOT_AGE_MINUTES=15
STARSHIP_EXECUTION_MODE=dry_run
STARSHIP_ALLOW_LIVE_EXECUTION=false

ETRADE_CONSUMER_KEY=your-etrade-consumer-key
ETRADE_CONSUMER_SECRET=your-etrade-consumer-secret
ETRADE_ENV=sandbox
ETRADE_CALLBACK_URL=oob
ETRADE_DEFAULT_ACCOUNT_ID_KEY=
ETRADE_OAUTH_TOKEN=
ETRADE_OAUTH_TOKEN_SECRET=

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
